# ChartPilot environment
#
# Copy this file to `.env.local` and paste your key. Leave everything blank to
# run in Demo Mode (real market data + the built-in rule-based intent parser).
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored — never commit a real key.

# Which provider to use: openrouter | openai | anthropic
LLM_PROVIDER=openrouter

# ── OpenRouter (recommended: one key, every model) ────────────────────────────
# Get a key at https://openrouter.ai/keys  (starts with sk-or-v1-)
OPENROUTER_API_KEY=
# Default model. ~$0.075/$0.25 per 1M tokens ≈ $0.0002 per request.
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# ── Alternatives (leave blank unless you switch LLM_PROVIDER) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
